@using Agitator.Models.ViewModel
@model List<ProjectListItemViewModel>

@if (!Model.Any())
{
    <p class="text-muted">No projects yet. <a href="/Projects/Create">Start a new agitator design</a> to see it here.</p>
}
else
{
    <table class="table table-hover bg-white">
        <thead>
            <tr>
                <th>Name</th>
                <th>Created</th>
                <th>3D Model Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td><span class="badge bg-secondary">@p.CadStatus</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/Projects/Results/@p.Id"><i class="bi bi-bar-chart"></i> Results</a>
                        <a class="btn btn-sm btn-outline-secondary" href="/Projects/Edit/@p.Id"><i class="bi bi-pencil"></i> Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}