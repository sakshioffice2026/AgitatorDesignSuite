@using Agitator.Utilities.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Agitator Design Suite</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="/"><i class="bi bi-gear-wide-connected"></i> Agitator Design Suite</a>
        <nav class="d-flex align-items-center gap-3">
            <a class="text-white text-decoration-none" href="/"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="text-white text-decoration-none" href="/Projects"><i class="bi bi-folder2"></i> Projects</a>
            <a class="text-white text-decoration-none" href="/Projects/Create"><i class="bi bi-plus-circle"></i> New Project</a>
            <span class="user-avatar" title="Account">S</span>
        </nav>
    </header>

    <div class="app-shell">

        <div class="app-content">
    <main class="container">
        @await Html.PartialAsync("_Breadcrumb", ViewData["Breadcrumb"] as List<BreadcrumbItem>)

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle"></i> @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer text-muted">
        &copy; @DateTime.Now. Company Name   Engineering tool
    </footer>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>