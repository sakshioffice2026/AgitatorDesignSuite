@using Agitator.Models.ViewModel
@model ProjectDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@Model.Name</h1>
    <div>
        <a class="btn btn-outline-secondary" href="/Projects/Edit/@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
        <a class="btn btn-outline-primary" href="/Projects/Results/@Model.Id"><i class="bi bi-bar-chart"></i> View Results</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Description))
{
    <p class="text-muted">@Model.Description</p>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="panel">
            <h2 class="h6">Vessel</h2>
            <table class="table table-sm kv mb-0">
                <tr><th>Diameter</th><td>@Model.Vessel?.DiameterM.ToString("F2") m</td></tr>
                <tr><th>Liquid height</th><td>@Model.Vessel?.LiquidHeightM.ToString("F2") m</td></tr>
                <tr><th>Baffles</th><td>@(Model.Vessel?.HasBaffles == true ? $"{Model.Vessel.NumberOfBaffles} baffles" : "None")</td></tr>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="panel">
            <h2 class="h6">Impeller</h2>
            <table class="table table-sm kv mb-0">
                <tr><th>Type</th><td>@Model.Impeller?.Type</td></tr>
                <tr><th>Diameter</th><td>@Model.Impeller?.DiameterM.ToString("F3") m</td></tr>
                <tr><th>Speed</th><td>@Model.Impeller?.RotationalSpeedRpm.ToString("F0") RPM</td></tr>
            </table>
        </div>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Delete this project? This cannot be undone.');">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete Project</button>
</form>