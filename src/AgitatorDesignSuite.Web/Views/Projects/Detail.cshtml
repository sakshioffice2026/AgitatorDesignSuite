@using Agitator.Models.ViewModel
@model ProjectDetailViewModel
@{
    ViewData["Title"] = Model.Name;
}

<style>
    .cockpit-wrap { width:100%; }
    .cockpit-header { background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:12px 14px; }
    .cockpit-card { background:#fff; border:1px solid #e2e8f0; border-radius:8px; height:100%; display:flex; flex-direction:column; }
    .cockpit-card-head { padding:10px 12px; border-bottom:1px solid #f1f5f9; background:#f8fafc; border-radius:8px 8px 0 0; }
    .cockpit-card-body { padding:12px; flex:1 1 auto; }
    .cockpit-title { font-size:0.95rem; font-weight:600; margin:0; color:#0f172a; }
    .cockpit-note { font-size:0.78rem; color:#64748b; }
</style>

<div class="cockpit-wrap container-fluid px-4">

    <div class="cockpit-header mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-0">@Model.Name</h1>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="cockpit-note">@Model.Description</div>
                }
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <a class="btn btn-outline-secondary btn-sm" href="/Projects/Edit/@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
                <a class="btn btn-outline-primary btn-sm" href="/Projects/Results/@Model.Id"><i class="bi bi-bar-chart"></i> View Results</a>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6 d-flex">
            <div class="d-flex flex-column h-100 w-100 gap-3">
                <div class="cockpit-card d-flex flex-column w-100">
                    <div class="cockpit-card-head">
                        <h2 class="cockpit-title">Vessel</h2>
                    </div>
                    <div class="cockpit-card-body">
                        <table class="table table-sm kv mb-0">
                            <tr><th>Diameter</th><td>@Model.Vessel?.DiameterM.ToString("F2") m</td></tr>
                            <tr><th>Liquid height</th><td>@Model.Vessel?.LiquidHeightM.ToString("F2") m</td></tr>
                            <tr><th>Baffles</th><td>@(Model.Vessel?.HasBaffles == true ? $"{Model.Vessel.NumberOfBaffles} baffles" : "None")</td></tr>
                        </table>
                    </div>
                </div>

                <div class="cockpit-card d-flex flex-column w-100 flex-grow-1">
                    <div class="cockpit-card-head">
                        <h2 class="cockpit-title">Impeller</h2>
                    </div>
                    <div class="cockpit-card-body">
                        <table class="table table-sm kv mb-0">
                            <tr><th>Type</th><td>@Model.Impeller?.Type</td></tr>
                            <tr><th>Diameter</th><td>@Model.Impeller?.DiameterM.ToString("F3") m</td></tr>
                            <tr><th>Speed</th><td>@Model.Impeller?.RotationalSpeedRpm.ToString("F0") RPM</td></tr>
                            <tr><th>Impeller mass</th><td>@(Model.Impeller is { ImpellerMassKg: > 0 } ? Model.Impeller.ImpellerMassKg.ToString("F1") + " kg" : "Not specified")</td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 d-flex">
            <div class="cockpit-card d-flex flex-column h-100 w-100">
                <div class="cockpit-card-head">
                    <h2 class="cockpit-title">Shaft material and operating conditions</h2>
                </div>
                <div class="cockpit-card-body">
                    <table class="table table-sm kv mb-0">
                        <tr><th>Shaft material</th><td>@(Model.Impeller?.ShaftMaterial?.Grade ?? "Not specified")</td></tr>
                        <tr><th>Heat treatment</th><td>@(Model.Impeller?.ShaftMaterial?.HeatTreatment ?? "Not specified")</td></tr>
                        <tr><th>Elastic modulus</th><td>@(Model.Impeller?.ShaftMaterial?.ElasticModulusGpa is decimal e ? e.ToString("F1") + " GPa" : "-")</td></tr>
                        <tr><th>Poisson's ratio</th><td>@(Model.Impeller?.ShaftMaterial?.PoissonRatio is decimal p ? p.ToString("F3") : "-")</td></tr>
                        <tr><th>Density</th><td>@(Model.Impeller?.ShaftMaterial?.DensityKgM3 is decimal d ? d.ToString("F0") + " kg/m³" : "-")</td></tr>
                        <tr><th>Endurance limit</th><td>@(Model.Impeller?.ShaftMaterial?.EnduranceLimitMpa is decimal en ? en.ToString("F0") + " MPa" : "Default (0.5 × ultimate)")</td></tr>
                        <tr><th>Surface finish</th><td>@(Model.Impeller?.ShaftMaterial?.SurfaceFinish ?? "machined")</td></tr>
                        <tr><th>Operating temperature</th><td>@(Model.FluidProperties?.OperatingTemperatureC.ToString("F1") ?? "-") °C</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Delete this project? This cannot be undone.');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete Project</button>
    </form>

</div>
