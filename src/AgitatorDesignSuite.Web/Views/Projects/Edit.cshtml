@using Agitator.Models.ViewModel
@model ProjectFormViewModel
@{
    ViewData["Title"] = "Edit Project";
}

<h1 class="mb-4">Edit @Model.Name</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("ProjectForm", Model)
    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save & Recalculate</button>
</form>