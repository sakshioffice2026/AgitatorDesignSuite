@using Agitator.Core.Entities
@using Agitator.Models.ViewModel
@using Agitator.Models.DTOs
@using Agitator.Business.Services
@model ProjectDetailViewModel
@{
    ViewData["Title"] = "Results";
    var r = Model.CalculationResult;

    string FmtNum(double? value)
    {
        if (!value.HasValue || double.IsNaN(value.Value) || double.IsInfinity(value.Value)) return "n/a";
        double a = Math.Abs(value.Value);
        string format = a == 0 ? "F2" : a < 1 ? "F4" : a < 100 ? "F2" : "F1";
        return value.Value.ToString(format);
    }

    string FmtPct(double value) => value.ToString("+0.00;-0.00;0.00") + " %";
}

<style>
    .cockpit-wrap { width:100%; }
    .cockpit-header { background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:12px 14px; }
    .cockpit-card { background:#fff; border:1px solid #e2e8f0; border-radius:8px; height:100%; display:flex; flex-direction:column; }
    .cockpit-card-head { padding:10px 12px; border-bottom:1px solid #f1f5f9; background:#f8fafc; border-radius:8px 8px 0 0; }
    .cockpit-card-body { padding:12px; flex:1 1 auto; }
    .cockpit-title { font-size:0.95rem; font-weight:600; margin:0; color:#0f172a; }
    .cockpit-note { font-size:0.78rem; color:#64748b; }
    .status-pill { display:inline-flex; align-items:center; gap:6px; border-radius:999px; padding:4px 12px; font-size:0.78rem; font-weight:600; border:1px solid transparent; }
    .status-pill .dot { width:8px; height:8px; border-radius:50%; background:currentColor; }
    .pill-green { background:#dcfce7; color:#166534; border-color:#bbf7d0; }
    .pill-amber { background:#fef3c7; color:#92400e; border-color:#fde68a; }
    .pill-red { background:#fee2e2; color:#991b1b; border-color:#fecaca; }
    .pill-grey { background:#f1f5f9; color:#475569; border-color:#e2e8f0; }
    .metric-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:8px; }
    .metric { background:#f8fafc; border:1px solid #f1f5f9; border-radius:6px; padding:8px 12px; }
    .metric .label { font-size:0.75rem; color:#64748b; }
    .metric .value { font-size:1.15rem; font-weight:600; color:#0f172a; }
    .metric .unit { font-size:0.78rem; font-weight:400; color:#64748b; }
    .util-track { position:relative; height:12px; background:#f1f5f9; border-radius:6px; overflow:hidden; }
    .util-fill { height:100%; border-radius:6px; }
    .util-fill.u-green { background:#22c55e; }
    .util-fill.u-amber { background:#f59e0b; }
    .util-fill.u-red { background:#ef4444; }
    .util-tick { position:absolute; top:0; bottom:0; width:2px; background:#fff; opacity:.9; }
    .util-legend span { display:inline-flex; align-items:center; gap:4px; margin-right:12px; }
    .util-legend i { width:10px; height:10px; border-radius:2px; display:inline-block; }
    .metric-grid.compact { grid-template-columns:repeat(3, minmax(0, 1fr)); gap:6px; }
    .metric-grid.compact .metric { padding:6px 8px; }
    .metric-grid.compact .label { font-size:0.7rem; }
    .metric-grid.compact .value { font-size:1rem; }
    .metric-grid.compact .value.sm { font-size:0.85rem; overflow-wrap:anywhere; }
    .cockpit-fit { height:calc(100vh - 240px); min-height:480px; display:flex; flex-direction:column; }
    .cockpit-fit > .cockpit-lower { flex:1 1 0; min-height:0; }
    .cockpit-lower > [class*="col-"] { min-height:0; }
    .cockpit-lower .cockpit-card { min-height:0; }
    .cockpit-lower .cockpit-card-body { overflow-y:auto; min-height:0; }
    #viewer-container { width:100%; height:300px; background:#f1f5f9; border-radius:6px; }
    .viewer-empty { height:200px; display:flex; align-items:center; justify-content:center; text-align:center; background:#f1f5f9; border:1px dashed #cbd5e1; border-radius:6px; color:#64748b; padding:16px; }
</style>

<div class="cockpit-wrap cockpit-fit container-fluid px-0">

@if (r is null)
{
    <h1 class="mb-1">@Model.Name</h1>
    <p class="mb-4" style="color:#64748B;font-size:0.9rem;">Calculated results and mechanical recommendations.</p>
    <p class="text-muted">No calculation results yet.</p>
}
else
{
    var shaftMat = Model.Impeller?.ShaftMaterial;
    var opTemp = Model.FluidProperties?.OperatingTemperatureC ?? 30;
    var allowableMpa = AgitatorCalculationService.ComputeAllowableShearStressPa(shaftMat, opTemp) / 1_000_000.0;
    bool hasPrediction = !string.IsNullOrWhiteSpace(r.PredictionJson);
    bool cadBusy = r.CadStatus == CadJobStatus.Queued || r.CadStatus == CadJobStatus.Running;
    bool showCad = cadBusy || r.CadStatus == CadJobStatus.Completed || r.CadStatus == CadJobStatus.Failed;
    bool showPinn = hasPrediction;
    string row2Col = (showCad && showPinn) ? "col-lg-6" : "col-12";

    string? feaStatus = null;
    string? feaError = null;
    double feaStress = 0;
    double feaAllowable = 0;
    double feaUtilization = 0;
    bool feaPassed = false;
    double? feaVonMises = null;
    double? feaTipDeflection = null;
    double? feaTwist = null;
    if (!string.IsNullOrWhiteSpace(r.FeaCheckJson))
    {
        try
        {
            using var feaDoc = System.Text.Json.JsonDocument.Parse(r.FeaCheckJson);
            var feaRoot = feaDoc.RootElement;
            feaStatus = feaRoot.TryGetProperty("status", out var feaStatusElement) ? feaStatusElement.GetString() : null;
            if (feaStatus == "ok")
            {
                feaStress = feaRoot.GetProperty("feaMaxShearMpa").GetDouble();
                feaAllowable = feaRoot.GetProperty("allowableShearMpa").GetDouble();
                feaUtilization = feaRoot.GetProperty("utilization").GetDouble();
                feaPassed = feaRoot.GetProperty("passed").GetBoolean();
                if (feaRoot.TryGetProperty("feaVonMisesMpa", out var feaVmElement) && feaVmElement.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    feaVonMises = feaVmElement.GetDouble();
                }
                if (feaRoot.TryGetProperty("feaTipDeflectionMm", out var feaTipElement) && feaTipElement.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    feaTipDeflection = feaTipElement.GetDouble();
                }
                if (feaRoot.TryGetProperty("feaTwistDeg", out var feaTwistElement) && feaTwistElement.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    feaTwist = feaTwistElement.GetDouble();
                }
            }
            else
            {
                feaError = feaRoot.TryGetProperty("error", out var feaErrorElement) ? feaErrorElement.GetString() : null;
            }
        }
        catch (System.Text.Json.JsonException)
        {
            feaStatus = null;
        }
        catch (InvalidOperationException)
        {
            feaStatus = null;
        }
        catch (KeyNotFoundException)
        {
            feaStatus = null;
        }
    }

    var badgeClass = r.CadStatus switch
    {
        CadJobStatus.Completed => "bg-success",
        CadJobStatus.Failed => "bg-danger",
        CadJobStatus.Running => "bg-warning text-dark",
        CadJobStatus.Queued => "bg-primary",
        _ => "bg-secondary"
    };

    var cadPill = r.CadStatus switch
    {
        CadJobStatus.Completed => "pill-green",
        CadJobStatus.Failed => "pill-red",
        CadJobStatus.Running => "pill-amber",
        CadJobStatus.Queued => "pill-amber",
        _ => "pill-grey"
    };

    string feaPill;
    string feaLabel;
    if (string.IsNullOrWhiteSpace(r.FeaCheckJson)) { feaPill = "pill-grey"; feaLabel = "Not run"; }
    else if (feaStatus == "ok" && feaPassed) { feaPill = "pill-green"; feaLabel = "Passed"; }
    else if (feaStatus == "ok") { feaPill = "pill-red"; feaLabel = "Failed"; }
    else { feaPill = "pill-amber"; feaLabel = "Warning"; }

    string pinnPill = hasPrediction ? "pill-green" : "pill-grey";
    string pinnLabel = hasPrediction ? "Completed" : "Not run";

    @* ===================== EXECUTIVE HEADER BAR ===================== *@
    <div class="cockpit-header mb-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <h1 class="mb-0" style="font-size:1.4rem;">@Model.Name</h1>
                    <span class="status-pill @cadPill"><span class="dot"></span>CAD: @r.CadStatus</span>
                    <span class="status-pill @feaPill"><span class="dot"></span>FEA: @feaLabel</span>
                    <span class="status-pill @pinnPill"><span class="dot"></span>PINN: @pinnLabel</span>
                </div>
                <div class="cockpit-note">Calculated results and mechanical recommendations</div>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <form asp-action="RequestCadModel" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@cadBusy"><i class="bi bi-box"></i> Generate 3D Model (FreeCAD)</button>
                </form>
                <form asp-action="GeneratePrediction" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-cpu"></i> @(hasPrediction ? "Regenerate Shaft Prediction (PINN)" : "Generate Shaft Prediction (PINN)")</button>
                </form>
                <a class="btn btn-outline-secondary btn-sm" href="/Projects/DownloadReport/@Model.Id"><i class="bi bi-file-earmark-pdf"></i> Download PDF Datasheet</a>
            </div>
        </div>
    </div>

    @* ===================== ROW 1: FOUR COMPACT CARDS ===================== *@
    <div class="row g-2 mb-2">
        <div class="col-xl-3 col-md-6 d-flex">
            <div class="cockpit-card d-flex flex-column h-100 w-100">
                <div class="cockpit-card-head d-flex justify-content-between align-items-center">
                    <h2 class="cockpit-title">Process dynamics</h2>
                    <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle">@r.Regime</span>
                </div>
                <div class="cockpit-card-body">
                    <div class="metric-grid compact">
                        <div class="metric"><div class="label">Reynolds number</div><div class="value">@r.ReynoldsNumber.ToString("F0")</div></div>
                        <div class="metric"><div class="label">Power number (Np)</div><div class="value">@r.PowerNumber.ToString("F3")</div></div>
                        <div class="metric"><div class="label">Power draw</div><div class="value">@r.PowerDrawWatts.ToString("F0") <span class="unit">W</span></div></div>
                        <div class="metric"><div class="label">Torque</div><div class="value">@r.TorqueNm.ToString("F2") <span class="unit">N·m</span></div></div>
                        <div class="metric"><div class="label">Tip speed</div><div class="value">@r.TipSpeedMPerS.ToString("F2") <span class="unit">m/s</span></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 d-flex">
            <div class="cockpit-card d-flex flex-column h-100 w-100">
                <div class="cockpit-card-head">
                    <h2 class="cockpit-title">Mechanical recommendations</h2>
                </div>
                <div class="cockpit-card-body">
                    <div class="metric-grid compact">
                        <div class="metric"><div class="label">Shaft diameter</div><div class="value">@r.RecommendedShaftDiameterMm.ToString("F1") <span class="unit">mm</span></div></div>
                        <div class="metric"><div class="label">Motor rating</div><div class="value">@r.RecommendedMotorPowerKw.ToString("F2") <span class="unit">kW</span></div></div>
                        @if (r.CriticalSpeedRpm.HasValue)
                        {
                            <div class="metric"><div class="label">Critical speed</div><div class="value">@r.CriticalSpeedRpm.Value.ToString("F0") <span class="unit">rpm</span></div></div>
                        }
                        @if (r.GoodmanFactor.HasValue)
                        {
                            <div class="metric"><div class="label">Goodman factor</div><div class="value">@r.GoodmanFactor.Value.ToString("F2")</div></div>
                        }
                        @if (r.TipDeflectionMm.HasValue)
                        {
                            <div class="metric"><div class="label">Tip deflection</div><div class="value">@r.TipDeflectionMm.Value.ToString("F3") <span class="unit">mm</span></div></div>
                        }
                        @if (r.TwistDeg.HasValue)
                        {
                            <div class="metric"><div class="label">Angle of twist</div><div class="value">@r.TwistDeg.Value.ToString("F3") <span class="unit">°</span></div></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 d-flex">
            <div class="cockpit-card d-flex flex-column h-100 w-100">
                <div class="cockpit-card-head">
                    <h2 class="cockpit-title">Shaft material and operating basis</h2>
                </div>
                <div class="cockpit-card-body">
                    <div class="metric-grid compact">
                        <div class="metric"><div class="label">Shaft material</div><div class="value sm">@(shaftMat?.Grade ?? "Not specified")</div></div>
                        <div class="metric"><div class="label">Heat treatment</div><div class="value sm">@(shaftMat?.HeatTreatment ?? "Not specified")</div></div>
                        <div class="metric"><div class="label">Operating temp.</div><div class="value">@opTemp.ToString("F1") <span class="unit">°C</span></div></div>
                        @if (shaftMat is not null)
                        {
                            <div class="metric"><div class="label">Yield at temp.</div><div class="value">@AgitatorCalculationService.ComputeYieldAtTemperatureMpa(shaftMat, opTemp).ToString("F1") <span class="unit">MPa</span></div></div>
                        }
                        <div class="metric"><div class="label">Allowable shear</div><div class="value">@allowableMpa.ToString("F1") <span class="unit">MPa</span></div></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 d-flex">
            <div class="cockpit-card d-flex flex-column h-100 w-100">
                <div class="cockpit-card-head">
                    <h2 class="cockpit-title">Project summary and quick reference</h2>
                </div>
                <div class="cockpit-card-body">
                    <div class="metric-grid compact">
                        <div class="metric"><div class="label">Vessel diameter</div><div class="value">@Model.Vessel?.DiameterM.ToString("F2") <span class="unit">m</span></div></div>
                        <div class="metric"><div class="label">Liquid height</div><div class="value">@Model.Vessel?.LiquidHeightM.ToString("F2") <span class="unit">m</span></div></div>
                        <div class="metric"><div class="label">Baffles</div><div class="value">@(Model.Vessel?.HasBaffles == true ? Model.Vessel.NumberOfBaffles.ToString() : "None")</div></div>
                        <div class="metric"><div class="label">Impeller type</div><div class="value sm">@Model.Impeller?.Type</div></div>
                        <div class="metric"><div class="label">Impeller dia.</div><div class="value">@Model.Impeller?.DiameterM.ToString("F3") <span class="unit">m</span></div></div>
                        <div class="metric"><div class="label">Speed</div><div class="value">@Model.Impeller?.RotationalSpeedRpm.ToString("F0") <span class="unit">RPM</span></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ===================== ROW 2: INTELLIGENCE & VALIDATION ===================== *@
    @if (showCad || showPinn)
    {
    <div class="row g-3 cockpit-lower">
        @* ---------- Column B: PINN + EMPIRICAL COMPARISON ---------- *@
        @if (showPinn)
        {
        <div id="pinn-section" class="@row2Col d-flex">
            <div class="cockpit-card d-flex flex-column h-100 w-100">
                <div class="cockpit-card-head">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h2 class="cockpit-title">Design checks and AI (PINN) comparison</h2>
                    </div>
                </div>
                <div class="cockpit-card-body">
                    @if (hasPrediction)
                    {
                        <partial name="_ShaftComparison" model="Model.ShaftComparison" />
                    }
                    else
                    {
                        <div class="alert alert-secondary py-2" role="status">
                            <i class="bi bi-info-circle-fill"></i>
                            No AI (PINN) prediction yet. Click "Generate Shaft Prediction (PINN)" to add the AI comparison. The design checks below use the manual formulas@(string.IsNullOrWhiteSpace(r.FeaCheckJson) ? "" : " and FEA").
                        </div>
                    }

                    @if (Model.ShaftComparison is not null)
                    {
                        <h3 class="h6 mt-3">Utilization (@Model.ShaftComparison.StandardShaftSizeMm.ToString("F0") mm shaft)</h3>
                        <div class="cockpit-note util-legend mb-3">
                            <span><i style="background:#22c55e"></i>≤ 75 %</span>
                            <span><i style="background:#f59e0b"></i>75–90 %</span>
                            <span><i style="background:#ef4444"></i>&gt; 90 %</span>
                        </div>
                        @foreach (var c in Model.ShaftComparison.Checks)
                        {
                            bool inf = double.IsInfinity(c.Utilization);
                            double pct = inf ? 100.0 : Math.Min(c.Utilization * 100.0, 100.0);
                            string fillClass = (!c.Passed || inf || c.Utilization > 0.90) ? "u-red" : c.Utilization > 0.75 ? "u-amber" : "u-green";
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <div class="small fw-semibold">@c.Name <span class="text-muted fw-normal">(@c.Unit)</span> <span class="badge bg-light text-dark border">@c.Source</span></div>
                                    <div class="small">
                                        @if (c.Passed)
                                        {
                                            <span class="badge bg-success">Pass</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Fail</span>
                                        }
                                    </div>
                                </div>
                                <div class="util-track my-1" role="progressbar"
                                     aria-label="@c.Name utilisation"
                                     aria-valuenow="@pct.ToString("F0")" aria-valuemin="0" aria-valuemax="100">
                                    <div class="util-fill @fillClass" style="width:@pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                    <div class="util-tick" style="left:75%"></div>
                                    <div class="util-tick" style="left:90%"></div>
                                </div>
                                <div class="d-flex justify-content-between cockpit-note">
                                    <span>Demand @FmtNum(c.DemandValue) <span>@c.DemandLabel</span></span>
                                    <span>Capacity @FmtNum(c.CapacityValue) <span>@c.CapacityLabel</span></span>
                                    <span>@(inf ? "n/a" : (c.Utilization * 100.0).ToString("F1") + " %") | @(inf ? "n/a" : FmtPct(c.MarginPercent))</span>
                                </div>
                            </div>
                        }
                        <p class="cockpit-note mb-0">Shafts come in fixed sizes, so the exact calculated size is moved up to the next available size.</p>
                    }
                </div>
            </div>
        </div>
        }

        @* ---------- Column A: 3D MODEL + FEA ---------- *@
        @if (showCad)
        {
        <div id="model-section" class="@row2Col d-flex">
            <div class="cockpit-card d-flex flex-column h-100 w-100">
                <div class="cockpit-card-head">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="cockpit-title">3D model and FEA check</h2>
                            <span id="cad-badge" class="badge @badgeClass">@r.CadStatus</span>
                        </div>
                        <div class="d-flex gap-2">
                            @if (r.CadStatus == CadJobStatus.Failed)
                            {
                                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Reset Status</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
                <div class="cockpit-card-body">
                    <p class="cockpit-note">Generating the 3D model also runs the shaft FEA check. Both finish before the status shows Completed.</p>

                    @if (r.CadStatus == CadJobStatus.Completed && r.CadStepFilePath != null)
                    {
                        <div id="viewer-container"
                             data-step-url="@Url.Action("DownloadCadStep", "Projects", new { id = Model.Id })"
                             data-preview-url="@(string.IsNullOrEmpty(r.CadPreviewMeshPath) ? null : Url.Action("PreviewMesh", "Projects", new { id = Model.Id }))"
                             style="width:100%;height:300px;background:#f1f5f9;border-radius:6px;"></div>
                        <p class="mt-2 mb-3 small"><a href="@Url.Action("DownloadCadStep", "Projects", new { id = Model.Id })"><i class="bi bi-download"></i> Download STEP file</a></p>
                    }
                    else if (r.CadStatus == CadJobStatus.Failed)
                    {
                        <div class="alert alert-danger py-2" role="alert"><i class="bi bi-x-circle"></i> 3D model generation failed. @r.CadJobError</div>
                    }
                    else if (cadBusy)
                    {
                        <div id="cad-progress" class="alert alert-info py-2 d-flex align-items-center gap-2" role="status">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span id="cad-progress-text">Model generation in progress. This page updates automatically.</span>
                        </div>
                    }
                    else
                    {
                        <div class="viewer-empty">No 3D model generated yet. Click "Generate 3D Model (FreeCAD)".</div>
                    }

                    <h3 class="h6 mt-3">Shaft FEA check (Finite Element Analysis)</h3>
                    @if (string.IsNullOrWhiteSpace(r.FeaCheckJson))
                    {
                        <p class="text-muted small mb-0">Not run yet. The FEA check runs automatically after "Generate 3D Model (FreeCAD)".</p>
                    }
                    else if (feaStatus == "ok")
                    {
                        if (feaPassed)
                        {
                            <div class="alert alert-success py-2" role="status">
                                <i class="bi bi-check-circle-fill"></i> FEA check passed. The stress in the recommended shaft is below the allowable limit.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger py-2" role="alert">
                                <i class="bi bi-x-circle-fill"></i> FEA check failed. The stress in the recommended shaft is above the allowable limit. Please ask an engineer to review.
                            </div>
                        }
                        <table class="table table-sm kv mb-2">
                            <tr><th>Shaft size checked</th><td>@r.RecommendedShaftDiameterMm.ToString("F0") mm</td></tr>
                            <tr><th>FEA maximum shear stress</th><td>@feaStress.ToString("F2") MPa</td></tr>
                            <tr><th>Allowable shear stress</th><td>@feaAllowable.ToString("F1") MPa</td></tr>
                            <tr><th>Utilization</th><td>@((feaUtilization * 100.0).ToString("F0")) %</td></tr>
                            @if (feaVonMises.HasValue)
                            {
                                <tr><th>FEA von Mises stress</th><td>@feaVonMises.Value.ToString("F2") MPa</td></tr>
                            }
                            @if (feaTipDeflection.HasValue)
                            {
                                <tr><th>FEA tip deflection</th><td>@feaTipDeflection.Value.ToString("F3") mm</td></tr>
                            }
                            @if (feaTwist.HasValue)
                            {
                                <tr><th>FEA angle of twist</th><td>@feaTwist.Value.ToString("F3") °</td></tr>
                            }
                        </table>
                        <p class="cockpit-note mb-1">The FEA applies the real loads to a 3D model of the shaft. It does not include the 1.5 bending safety factor used in the formula, so its stress is normally lower than the formula stress.</p>
                        <p class="cockpit-note mb-0">Checked @r.FeaCheckedAt?.ToString("yyyy-MM-dd HH:mm") UTC</p>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> The FEA check could not be completed. @feaError
                        </div>
                    }
                </div>
            </div>
        </div>
        }
    </div>
    }
    else
    {
        <div class="cockpit-lower d-flex">
            <div class="cockpit-card w-100 align-items-center justify-content-center text-center">
                <div class="cockpit-note p-3">No advanced analysis started yet. Use "Generate 3D Model (FreeCAD)" or "Generate Shaft Prediction (PINN)" in the header.</div>
            </div>
        </div>
    }
}

</div>

@section Scripts {
    @if (r is not null && (r.CadStatus == CadJobStatus.Queued || r.CadStatus == CadJobStatus.Running))
    {
        <script>
            (function () {
                var statusUrl = '@Url.Action("CadStatus", "Projects", new { id = Model.Id })';
                var badge = document.getElementById('cad-badge');
                var text = document.getElementById('cad-progress-text');
                var failures = 0;
                var timer = null;

                function schedule(ms) {
                    if (timer) clearTimeout(timer);
                    timer = setTimeout(poll, ms);
                }

                function reloadToModelSection() {
                    // Keep the reader on the 3D model section after the reload.
                    window.location.hash = 'model-section';
                    window.location.reload();
                }

                function poll() {
                    if (document.hidden) {
                        // Do not poll in a background tab; resume on visibilitychange.
                        return;
                    }
                    fetch(statusUrl, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin', cache: 'no-store' })
                        .then(function (res) {
                            if (!res.ok) throw new Error('HTTP ' + res.status);
                            return res.json();
                        })
                        .then(function (data) {
                            failures = 0;
                            if (data.status !== 'Queued' && data.status !== 'Running') {
                                // Completed, Failed, or reset: show the final page state.
                                reloadToModelSection();
                                return;
                            }
                            if (badge) badge.textContent = data.status;
                            if (text) {
                                text.textContent = data.status === 'Running'
                                    ? 'Generating 3D model and running FEA check in FreeCAD...'
                                    : 'Waiting in queue...';
                            }
                            schedule(3000);
                        })
                        .catch(function () {
                            failures++;
                            if (failures >= 5) {
                                if (text) text.textContent = 'Unable to check status. Please reload the page.';
                                return;
                            }
                            schedule(5000);
                        });
                }

                document.addEventListener('visibilitychange', function () {
                    if (!document.hidden) schedule(500);
                });

                schedule(2000);
            })();
        </script>
    }
    @if (r is not null && r.CadStatus == CadJobStatus.Completed && r.CadStepFilePath != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
        <script src="~/js/step-viewer.js"></script>
    }
}
