@using Agitator.Core.Entities
@using Agitator.Models.ViewModel
@using Agitator.Models.DTOs
@using Agitator.Business.Services
@model ProjectDetailViewModel
@{
    ViewData["Title"] = "Results";
    var r = Model.CalculationResult;
}
<h1 class="mb-1">@Model.Name</h1>
<p class="mb-4" style="color:#64748B;font-size:0.9rem;">Calculated results and mechanical recommendations.</p>
@if (r is null)
{
    <p class="text-muted">No calculation results yet.</p>
}
else
{
    <div class="row g-3">
        <div class="col-md-6 d-flex">
            <div class="panel w-100">
                <h2 class="h6">Process Results</h2>
                <table class="table table-sm kv mb-0">
                    <tr><th>Reynolds number</th><td>@r.ReynoldsNumber.ToString("F0") (@r.Regime)</td></tr>
                    <tr><th>Power number (Np)</th><td>@r.PowerNumber.ToString("F3")</td></tr>
                    <tr><th>Power draw</th><td>@r.PowerDrawWatts.ToString("F0") W</td></tr>
                    <tr><th>Torque</th><td>@r.TorqueNm.ToString("F2") N·m</td></tr>
                    <tr><th>Tip speed</th><td>@r.TipSpeedMPerS.ToString("F2") m/s</td></tr>
                </table>
            </div>
        </div>

        <div class="col-md-6 d-flex">
            <div class="panel w-100">
                <h2 class="h6">Mechanical Recommendations</h2>
                <table class="table table-sm kv mb-0">
                    <tr><th>Shaft diameter</th><td>@r.RecommendedShaftDiameterMm.ToString("F1") mm</td></tr>
                    <tr><th>Motor rating</th><td>@r.RecommendedMotorPowerKw.ToString("F2") kW</td></tr>
                    @if (r.TipDeflectionMm.HasValue)
                    {
                        <tr><th>Tip deflection (manual)</th><td>@r.TipDeflectionMm.Value.ToString("F3") mm</td></tr>
                    }
                    @if (r.TwistDeg.HasValue)
                    {
                        <tr><th>Angle of twist (manual)</th><td>@r.TwistDeg.Value.ToString("F3") °</td></tr>
                    }
                    @if (r.CriticalSpeedRpm.HasValue)
                    {
                        <tr><th>First critical speed</th><td>@r.CriticalSpeedRpm.Value.ToString("F0") rpm</td></tr>
                    }
                    @if (r.GoodmanFactor.HasValue)
                    {
                        <tr><th>Goodman fatigue factor</th><td>@r.GoodmanFactor.Value.ToString("F2")</td></tr>
                    }
                </table>
            </div>
        </div>
    </div>

    var shaftMat = Model.Impeller?.ShaftMaterial;
    var opTemp = Model.FluidProperties?.OperatingTemperatureC ?? 30;
    var allowableMpa = AgitatorCalculationService.ComputeAllowableShearStressPa(shaftMat, opTemp) / 1_000_000.0;

    <div class="row g-3 mt-0">
        <div class="col-12">
            <div class="panel">
                <h2 class="h6">Shaft Design Basis</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <table class="table table-sm kv mb-0">
                            <tr><th>Shaft material</th><td>@(shaftMat?.Grade ?? "Not specified")</td></tr>
                            <tr><th>Heat treatment</th><td>@(shaftMat?.HeatTreatment ?? "Not specified")</td></tr>
                            <tr><th>Operating temperature</th><td>@opTemp.ToString("F1") °C</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-sm kv mb-0">
                            @if (shaftMat is not null)
                            {
                                <tr><th>Yield strength at temperature</th><td>@AgitatorCalculationService.ComputeYieldAtTemperatureMpa(shaftMat, opTemp).ToString("F1") MPa</td></tr>
                            }
                            <tr><th>Allowable shear stress</th><td>@allowableMpa.ToString("F1") MPa</td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    ShaftPredictionResult? pred = null;
    if (!string.IsNullOrWhiteSpace(r.PredictionJson))
    {
        try
        {
            pred = System.Text.Json.JsonSerializer.Deserialize<ShaftPredictionResult>(r.PredictionJson);
        }
        catch (System.Text.Json.JsonException)
        {
            pred = null;
        }
    }

    <div class="panel mt-3">
        <h2 class="h6">Shaft Diameter: Manual Calculation vs PINN (AI) Calculation</h2>

        @if (pred is null)
        {
            <p class="text-muted mb-0">No prediction generated yet. Click "Generate Shaft Prediction (PINN)" below. The formula result remains the official value.</p>
        }
        else
        {
            bool aiAgrees = Model.ShaftComparison is not null
                ? Model.ShaftComparison.AllQuantitiesAgree
                : pred.IsTrusted && Math.Abs(pred.PredictedShaftDiameterMm - pred.FormulaShaftDiameterMm) < 0.05;
            if (aiAgrees)
            {
                <div class="alert alert-success py-2" role="status">
                    <i class="bi bi-check-circle-fill"></i> AI check agrees with the formula. The recommended shaft size is confirmed.
                </div>
            }
            else
            {
                <div class="alert alert-warning py-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> AI check does not fully agree with the formula. Please use the formula result and ask an engineer to review.
                </div>
            }
            <table class="table table-sm mb-2">
                <thead>
                    <tr>
                        <th></th>
                        <th>Manual calculation</th>
                        <th>PINN (AI) calculation</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Exact shaft diameter</th>
                        <td>@pred.RawFormulaDiameterMm.ToString("F2") mm</td>
                        <td>@pred.RawPredictedDiameterMm.ToString("F2") mm</td>
                    </tr>
                    <tr>
                        <th>Shaft size to use</th>
                        <td>@pred.FormulaShaftDiameterMm.ToString("F0") mm</td>
                        <td>@pred.PredictedShaftDiameterMm.ToString("F0") mm</td>
                    </tr>
                </tbody>
            </table>
            <p class="mb-1">Difference between the two: @Math.Abs(pred.GapPercent).ToString("F2") %</p>
            <p class="mb-2">Strength check: @pred.ShearStressMpa.ToString("F2") MPa used, @pred.AllowableShearStressMpa.ToString("F1") MPa allowed</p>
            <p class="text-muted small mb-1">Shafts come in fixed sizes, so the exact calculated size is moved up to the next available size.</p>
            <p class="text-muted small mb-2">Model version @pred.ModelVersion, generated @pred.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
            @if (!string.IsNullOrWhiteSpace(pred.Notes))
            {
                <div class="alert alert-secondary py-2 mb-0" role="note">@pred.Notes</div>
            }
        }
    </div>

    string? feaStatus = null;
    string? feaError = null;
    double feaStress = 0;
    double feaAllowable = 0;
    double feaUtilization = 0;
    bool feaPassed = false;
    double? feaVonMises = null;
    double? feaTipDeflection = null;
    double? feaTwist = null;
    if (!string.IsNullOrWhiteSpace(r.FeaCheckJson))
    {
        try
        {
            using var feaDoc = System.Text.Json.JsonDocument.Parse(r.FeaCheckJson);
            var feaRoot = feaDoc.RootElement;
            feaStatus = feaRoot.TryGetProperty("status", out var feaStatusElement) ? feaStatusElement.GetString() : null;
            if (feaStatus == "ok")
            {
                feaStress = feaRoot.GetProperty("feaMaxShearMpa").GetDouble();
                feaAllowable = feaRoot.GetProperty("allowableShearMpa").GetDouble();
                feaUtilization = feaRoot.GetProperty("utilization").GetDouble();
                feaPassed = feaRoot.GetProperty("passed").GetBoolean();
                if (feaRoot.TryGetProperty("feaVonMisesMpa", out var feaVmElement) && feaVmElement.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    feaVonMises = feaVmElement.GetDouble();
                }
                if (feaRoot.TryGetProperty("feaTipDeflectionMm", out var feaTipElement) && feaTipElement.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    feaTipDeflection = feaTipElement.GetDouble();
                }
                if (feaRoot.TryGetProperty("feaTwistDeg", out var feaTwistElement) && feaTwistElement.ValueKind == System.Text.Json.JsonValueKind.Number)
                {
                    feaTwist = feaTwistElement.GetDouble();
                }
            }
            else
            {
                feaError = feaRoot.TryGetProperty("error", out var feaErrorElement) ? feaErrorElement.GetString() : null;
            }
        }
        catch (System.Text.Json.JsonException)
        {
            feaStatus = null;
        }
        catch (InvalidOperationException)
        {
            feaStatus = null;
        }
        catch (KeyNotFoundException)
        {
            feaStatus = null;
        }
    }

    <div class="panel mt-3">
        <h2 class="h6">Shaft FEA Check (Finite Element Analysis)</h2>

        @if (string.IsNullOrWhiteSpace(r.FeaCheckJson))
        {
            <p class="text-muted mb-0">The FEA check runs automatically after "Generate 3D Model (FreeCAD)".</p>
        }
        else if (feaStatus == "ok")
        {
            if (feaPassed)
            {
                <div class="alert alert-success py-2" role="status">
                    <i class="bi bi-check-circle-fill"></i> FEA check passed. The stress in the recommended shaft is below the allowable limit.
                </div>
            }
            else
            {
                <div class="alert alert-danger py-2" role="alert">
                    <i class="bi bi-x-circle-fill"></i> FEA check failed. The stress in the recommended shaft is above the allowable limit. Please ask an engineer to review.
                </div>
            }
            <table class="table table-sm kv mb-2">
                <tr><th>Shaft size checked</th><td>@r.RecommendedShaftDiameterMm.ToString("F0") mm</td></tr>
                <tr><th>FEA maximum shear stress</th><td>@feaStress.ToString("F2") MPa</td></tr>
                <tr><th>Allowable shear stress</th><td>@feaAllowable.ToString("F1") MPa</td></tr>
                <tr><th>Utilization</th><td>@((feaUtilization * 100.0).ToString("F0")) %</td></tr>
                @if (feaVonMises.HasValue)
                {
                    <tr><th>FEA von Mises stress</th><td>@feaVonMises.Value.ToString("F2") MPa</td></tr>
                }
                @if (feaTipDeflection.HasValue)
                {
                    <tr><th>FEA tip deflection</th><td>@feaTipDeflection.Value.ToString("F3") mm</td></tr>
                }
                @if (feaTwist.HasValue)
                {
                    <tr><th>FEA angle of twist</th><td>@feaTwist.Value.ToString("F3") °</td></tr>
                }
            </table>
            <p class="text-muted small mb-1">The FEA applies the real loads to a 3D model of the shaft. It does not include the 1.5 bending safety factor used in the formula, so its stress is normally lower than the formula stress.</p>
            <p class="text-muted small mb-0">Checked @r.FeaCheckedAt?.ToString("yyyy-MM-dd HH:mm") UTC</p>
        }
        else
        {
            <div class="alert alert-warning py-2 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> The FEA check could not be completed. @feaError
            </div>
        }
    </div>

    <div class="panel mt-3">
        <h2 class="h6">Shaft Comparison and Design Checks</h2>
        <partial name="_ShaftComparison" model="Model.ShaftComparison" />
    </div>

    <div class="d-flex gap-2 my-3">
        <a class="btn btn-outline-secondary" href="/Projects/DownloadReport/@Model.Id"><i class="bi bi-file-earmark-pdf"></i> Download PDF Datasheet</a>

        <form asp-action="RequestCadModel" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary"><i class="bi bi-box"></i> Generate 3D Model (FreeCAD)</button>
        </form>

        <form asp-action="GeneratePrediction" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-cpu"></i> Generate Shaft Prediction (PINN)</button>
        </form>

        @if (r.CadStatus == CadJobStatus.Failed)
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning"><i class="bi bi-arrow-counterclockwise"></i> Reset Status</button>
            </form>
        }
    </div>

    <div class="panel">
        @{
            var badgeClass = r.CadStatus switch
            {
                CadJobStatus.Completed => "bg-success",
                CadJobStatus.Failed => "bg-danger",
                CadJobStatus.Running => "bg-warning text-dark",
                CadJobStatus.Queued => "bg-primary",
                _ => "bg-secondary"
            };
        }
        <h2 class="h6">3D Model Status: <span id="cad-badge" class="badge @badgeClass">@r.CadStatus</span></h2>
        @if (r.CadStatus == CadJobStatus.Completed && r.CadStepFilePath != null)
        {
            <div class="alert alert-success py-2" role="alert"><i class="bi bi-check-circle"></i> 3D model generated successfully.</div>
            <div id="viewer-container"
                 data-step-url="@Url.Action("DownloadCadStep", "Projects", new { id = Model.Id })"
                 data-preview-url="@(string.IsNullOrEmpty(r.CadPreviewMeshPath) ? null : Url.Action("PreviewMesh", "Projects", new { id = Model.Id }))"
                 style="width:100%;height:500px;background:#f1f5f9;border-radius:6px;"></div>
            <p class="mt-2"><a href="@Url.Action("DownloadCadStep", "Projects", new { id = Model.Id })"><i class="bi bi-download"></i> Download STEP file</a></p>
        }
        else if (r.CadStatus == CadJobStatus.Failed)
        {
            <div class="alert alert-danger py-2" role="alert"><i class="bi bi-x-circle"></i> 3D model generation failed. @r.CadJobError</div>
        }
        else if (r.CadStatus == CadJobStatus.Queued || r.CadStatus == CadJobStatus.Running)
        {
            <div id="cad-progress" class="alert alert-info py-2 d-flex align-items-center gap-2" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span id="cad-progress-text">Model generation in progress. This page updates automatically.</span>
            </div>
        }
        else
        {
            <p class="text-muted">No 3D model generated yet. Click "Generate 3D Model" above.</p>
        }
    </div>
}

@section Scripts {
    @if (r?.CadStatus == CadJobStatus.Queued || r?.CadStatus == CadJobStatus.Running)
    {
        <script>
            (function () {
                var statusUrl = '@Url.Action("CadStatus", "Projects", new { id = Model.Id })';
                var badge = document.getElementById('cad-badge');
                var text = document.getElementById('cad-progress-text');
                var failures = 0;

                function poll() {
                    fetch(statusUrl, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                        .then(function (res) {
                            if (!res.ok) throw new Error('HTTP ' + res.status);
                            return res.json();
                        })
                        .then(function (data) {
                            failures = 0;
                            if (data.status === 'Completed' || data.status === 'Failed') {
                                window.location.reload();
                                return;
                            }
                            if (badge) badge.textContent = data.status;
                            if (text) {
                                text.textContent = data.status === 'Running'
                                    ? 'Generating 3D model in FreeCAD...'
                                    : 'Waiting in queue...';
                            }
                            setTimeout(poll, 3000);
                        })
                        .catch(function () {
                            failures++;
                            if (failures >= 5) {
                                if (text) text.textContent = 'Unable to check status. Please reload the page.';
                                return;
                            }
                            setTimeout(poll, 5000);
                        });
                }

                setTimeout(poll, 2000);
            })();
        </script>
    }
    @if (r?.CadStatus == CadJobStatus.Completed && r.CadStepFilePath != null)
    {
        <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
        <script src="~/js/step-viewer.js"></script>
    }
}
