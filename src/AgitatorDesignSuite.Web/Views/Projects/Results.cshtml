@using Agitator.Core.Entities
@using Agitator.Models.ViewModel
@model ProjectDetailViewModel
@{
    ViewData["Title"] = "Results";
    var r = Model.CalculationResult;
}
<h1 class="mb-1">@Model.Name</h1>
<p class="mb-4" style="color:#64748B;font-size:0.9rem;">Calculated results and mechanical recommendations.</p>
@if (r is null)
{
    <p class="text-muted">No calculation results yet.</p>
}
else
{
    <div class="row g-3">
        <div class="col-md-6">
            <div class="panel">
                <h2 class="h6">Process Results</h2>
                <table class="table table-sm kv mb-0">
                    <tr><th>Reynolds number</th><td>@r.ReynoldsNumber.ToString("F0") (@r.Regime)</td></tr>
                    <tr><th>Power number (Np)</th><td>@r.PowerNumber.ToString("F3")</td></tr>
                    <tr><th>Power draw</th><td>@r.PowerDrawWatts.ToString("F0") W</td></tr>
                    <tr><th>Torque</th><td>@r.TorqueNm.ToString("F2") N·m</td></tr>
                    <tr><th>Tip speed</th><td>@r.TipSpeedMPerS.ToString("F2") m/s</td></tr>
                </table>
            </div>
        </div>

        <div class="col-md-6">
            <div class="panel">
                <h2 class="h6">Mechanical Recommendations</h2>
                <table class="table table-sm kv mb-0">
                    <tr><th>Shaft diameter</th><td>@r.RecommendedShaftDiameterMm.ToString("F1") mm</td></tr>
                    <tr><th>Motor rating</th><td>@r.RecommendedMotorPowerKw.ToString("F2") kW</td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 my-3">
        <a class="btn btn-outline-secondary" href="/Projects/DownloadReport/@Model.Id"><i class="bi bi-file-earmark-pdf"></i> Download PDF Datasheet</a>

        <form asp-action="RequestCadModel" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary"><i class="bi bi-box"></i> Generate 3D Model (FreeCAD)</button>
        </form>

        @if (r.CadStatus == CadJobStatus.Failed)
        {
            <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning"><i class="bi bi-arrow-counterclockwise"></i> Reset Status</button>
            </form>
        }
    </div>

    <div class="panel">
        <h2 class="h6">3D Model Status: <span class="badge bg-secondary">@r.CadStatus</span></h2>
        @if (r.CadStatus == CadJobStatus.Completed && r.CadPreviewMeshPath != null)
        {
            <div id="viewer-container" style="width:100%;height:400px;background:#0b0f14;border-radius:6px;"></div>
            <p class="mt-2"><a href="@Url.Action("DownloadCadStep", "Projects", new { id = Model.Id })"><i class="bi bi-download"></i> Download STEP file</a></p>
        }
        else if (r.CadStatus == CadJobStatus.Failed)
        {
            <p class="text-danger">Model generation failed: @r.CadJobError</p>
        }
        else if (r.CadStatus == CadJobStatus.Queued || r.CadStatus == CadJobStatus.Running)
        {
            <p>Model generation in progress — this page does not auto-refresh yet; reload to check status.</p>
        }
        else
        {
            <p class="text-muted">No 3D model generated yet. Click "Generate 3D Model" above.</p>
        }
    </div>
}

@section Scripts {
    @if (r?.CadStatus == CadJobStatus.Completed && r.CadPreviewMeshPath != null)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/examples/js/loaders/OBJLoader.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/examples/js/controls/OrbitControls.js"></script>
        <script>
            (function () {
                var container = document.getElementById('viewer-container');
                var width = container.clientWidth;
                var height = container.clientHeight;

                var scene = new THREE.Scene();
                var camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 100000);

                var renderer = new THREE.WebGLRenderer({ antialias: true });
                renderer.setSize(width, height);
                container.appendChild(renderer.domElement);

                scene.add(new THREE.AmbientLight(0xffffff, 0.6));
                var dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
                dirLight.position.set(1, 1, 1);
                scene.add(dirLight);

                var controls = new THREE.OrbitControls(camera, renderer.domElement);

                var loader = new THREE.OBJLoader();
                loader.load('@Url.Action("PreviewMesh", "Projects", new { id = Model.Id })', function (obj) {
                    obj.traverse(function (child) {
                        if (child.isMesh) {
                            child.material = new THREE.MeshStandardMaterial({ color: 0x4a90d9 });
                        }
                    });

                    var box = new THREE.Box3().setFromObject(obj);
                    var center = box.getCenter(new THREE.Vector3());
                    var size = box.getSize(new THREE.Vector3());
                    var maxDim = Math.max(size.x, size.y, size.z) || 1;

                    obj.position.sub(center);
                    scene.add(obj);

                    camera.position.set(maxDim, maxDim, maxDim);
                    camera.lookAt(0, 0, 0);
                    controls.target.set(0, 0, 0);
                    controls.update();

                    animate();
                }, undefined, function (err) {
                    container.innerHTML = '<p class="text-danger p-3 mb-0">Unable to load 3D preview.</p>';
                    console.error('OBJ load failed:', err);
                });

                function animate() {
                    requestAnimationFrame(animate);
                    controls.update();
                    renderer.render(scene, camera);
                }

                window.addEventListener('resize', function () {
                    var w = container.clientWidth;
                    var h = container.clientHeight;
                    camera.aspect = w / h;
                    camera.updateProjectionMatrix();
                    renderer.setSize(w, h);
                });
            })();
        </script>
    }
}
