@using Agitator.Models.ViewModel
@model ProjectFormViewModel
@{
    ViewData["Title"] = "New Project";
}

<h1 class="mb-4">New Agitator Design</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("ProjectForm", Model)
    <button type="submit" class="btn btn-primary"><i class="bi bi-calculator"></i> Run Calculations</button>
</form>