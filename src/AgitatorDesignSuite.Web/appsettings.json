{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=agitator_design_suite;User=root;Password=root;TreatTinyAsBoolean=true;"
  },

  "CadIntegration": {
    "FreeCadCmdPath": "D:\\FreeCAD 1.1\\bin\\python.exe",
    "MacroPath": "CadScripts\\generate_agitator_model.py",
    "OutputDirectory": "D:\\AgitatorSuite\\CadOutput",
    "PollingIntervalSeconds": 5
  },

  "ReportGeneration": {
    "OutputDirectory": "D:\\AgitatorSuite\\Reports",
    "CompanyName": "Agitator",
    "CompanyLogoPath": "wwwroot\\images\\logo.png"
  },

  "ShaftPredictionService": {
    "BaseUrl": "http://127.0.0.1:8001",
    "TimeoutSeconds": 10,
    "RetryCount": 1,
    "TolerancePercent": 10.0
  },

  "ShaftComparison": {
    "DiameterTolerancePercent": 5.0,
    "DeflectionTolerancePercent": 5.0,
    "TwistTolerancePercent": 5.0,
    "DeflectionLimitRatio": 0.001,
    "MaxCriticalSpeedRatio": 0.7,
    "RequiredFatigueFactor": 1.5
  }
